# Postgres connection string. Aiven and most hosts require sslmode=require.
DATABASE_URL="postgres://avnadmin:password@pg-abc123-bigcart.a.aivencloud.com:12345/defaultdb?sslmode=require"

# Signs the auth JWTs. Generate with: openssl rand -base64 32
JWT_SECRET="replace-me-with-a-random-32-byte-string"

# Resend API key, used for the password reset emails.
RESEND_API_KEY="re_000000000000000000000000"

# Optional. Defaults to 4321 if unset; Render sets this itself.
PORT=4321
