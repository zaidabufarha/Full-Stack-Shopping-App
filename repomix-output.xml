                            for (int i = 0; i < list.length; i++)
                              CreditCardCard(list[i], (updatedCard) {
                                setState(() {
                                  editedCardIndex = i;
                                  list[i] = updatedCard;
                                  if (updatedCard.isDefault) {
                                    for (int j = 0; j < list.length; j++) {
