        const ShopState.loading(),
        predicate<ShopState>((state) => state.maybeWhen(
              error: (msg) => msg.isNotEmpty,
              orElse: () => false,
            )),
      ],
    );
  });

  group('attemptGetCategoryList', () {
    blocTest<ShopCubit, ShopState>(
      'emits [loading, loadedCategories] on success',
