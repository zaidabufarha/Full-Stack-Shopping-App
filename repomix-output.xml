                  onPressed: () {
                    setState(() {
                      widget.product.isFavorite = !widget.product.isFavorite;
                      context.read<ShopCubit>().attemptToggleFavorite(
                        widget.product.id,
                        widget.product.isFavorite,
                      );
                    });
                  },
                  icon: Icon(
                    (widget.product.isFavorite)
                        ? Icons.favorite
                        : Icons.favorite_border,
                    color: Colors.red,
